# ============================================================================
# .gitignore for SFL-EMB
# de Varda et al., "Behavioral and Brain Responses to Language Reflect
# Different Levels of Linguistic Representation"
#
# Code + small results + curated input data under data/ are tracked. Large raw
# arrays / audio / model caches are excluded (regenerable or backed up externally).
# NOTE: git does not support trailing comments on pattern lines.
# ============================================================================

# ----- Python -----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
.DS_Store
*.swp
.idea/
.vscode/
.claude/*

# ----- derived / regenerable (recomputed ex novo by the pipeline) -----
# extractor embedding/surprisal cache
cache/
# passage-label source parquet (data/pereira/Pereira.parquet.gzip)
*.parquet.gzip

# ----- large RAW data (back up externally; do NOT delete) -----
# ~2 GB fMRI subject arrays
data/wehbe/data_subject_*.npy
# large Tuckute response table
data/tuckute/brain-lang-data_participant_*.csv
# audio
data/natstor_fmri/sound_data/
*.wav
# raw timeseries
data/natstor_fmri/NaturalStories_TimeSeries_*.csv

# data/ is otherwise TRACKED, including data/NaturalStories/natstor_maze.rds
# (~51 MB, under GitHub's per-file limit).

# ----- run outputs (regenerable; commit final summary CSVs selectively) -----
results/*_predictions
results_extremes/
check-features/preds/
check-features/results_features.csv
check-features/analysis/permodel_*.csv
check-features/analysis/brain_summary_*.csv

# generated figures (regenerable)
figures/*.svg
figures/*.png
figures/paper/
figures/paper_rff/

# overleaf (a nested git repo; ignore the whole dir, not just its contents)
6a56bd55cbb8310ac4c1e6db/

# generated SFL-decomposition figures
figures/decomp/

# generated reliability figures
figures/reliability/
figures/model_size/
figures/layerwise/
appendix/layerwise_significance.csv
